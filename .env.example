# mock | rest | mcp
VITE_AZURE_DEVOPS_PROVIDER=rest

VITE_AZURE_DEVOPS_ORGANIZATION=
VITE_AZURE_DEVOPS_PROJECT=
VITE_AZURE_DEVOPS_TEAM=

# Personal Access Token do Azure DevOps. NUNCA use o prefixo VITE_ aqui.
# Escopos mínimos: Work Items (Read) e Project and Team (Read).
AZURE_DEVOPS_PAT=

# Opcional: transporte HTTP para um MCP, se o ambiente expuser um.
VITE_AZURE_DEVOPS_MCP_URL=
VITE_AZURE_DEVOPS_MCP_TOOL_CURRENT_USER=
VITE_AZURE_DEVOPS_MCP_TOOL_CURRENT_SPRINT=
VITE_AZURE_DEVOPS_MCP_TOOL_USER_WORK_ITEMS=
VITE_AZURE_DEVOPS_MCP_TOOL_WORK_ITEM_DETAILS=
