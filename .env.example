# mock | rest | mcp
VITE_AZURE_DEVOPS_PROVIDER=rest

VITE_AZURE_DEVOPS_ORGANIZATION=
VITE_AZURE_DEVOPS_PROJECT=
VITE_AZURE_DEVOPS_TEAM=

# Opcional: projeto e IDs das definições exibidas na aba Pipelines.
# Use quando as pipelines estão em outro projeto do Azure DevOps.
AZURE_DEVOPS_PIPELINE_PROJECT=
AZURE_DEVOPS_PIPELINE_DEFINITION_IDS=

# Personal Access Token do Azure DevOps. NUNCA use o prefixo VITE_ aqui.
# Escopos mínimos: Work Items (Read & write), Project and Team (Read),
# Code (Read) e Build (Read).
AZURE_DEVOPS_PAT=

# Opcional: tipo de Work Item usado para o cartão de deploy. Padrão: Task.
AZURE_DEVOPS_DEPLOY_WORK_ITEM_TYPE=Task

# Opcional: transporte HTTP para um MCP, se o ambiente expuser um.
VITE_AZURE_DEVOPS_MCP_URL=
VITE_AZURE_DEVOPS_MCP_TOOL_CURRENT_USER=
VITE_AZURE_DEVOPS_MCP_TOOL_USER_PIPELINES=
VITE_AZURE_DEVOPS_MCP_TOOL_CURRENT_SPRINT=
VITE_AZURE_DEVOPS_MCP_TOOL_SPRINTS=
VITE_AZURE_DEVOPS_MCP_TOOL_USER_WORK_ITEMS=
VITE_AZURE_DEVOPS_MCP_TOOL_WORK_ITEM_DETAILS=
